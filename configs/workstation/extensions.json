{
  "schema_version": 1,
  "skill_policy": {
    "include_upstream": [
      "arxiv", "grounded-citations", "blocked-page-recovery",
      "pdf", "docx", "xlsx", "powerpoint",
      "github", "python-debugpy", "systematic-debugging"
    ]
  },
  "skills": [
    "research-literature",
    "ars-deep-research",
    "ars-academic-paper",
    "ars-academic-paper-reviewer",
    "ars-academic-pipeline",
    "npy3d-visualization",
    "pvdata-import",
    "pvdata-visualization",
    "latex-paper",
    "research-frontier"
  ],
  "skill_sources": {
    "npy3d-visualization": "mcp/cfd-npy3d/skills/npy3d_visualization",
    "pvdata-import": "mcp/cfd-npy3d/skills/pvdata_import",
    "pvdata-visualization": "mcp/cfd-npy3d/skills/pvdata_visualization",
    "latex-paper": "plugins/latex-paper/skills/latex-paper",
    "research-frontier": "plugins/research-frontier/skills/research-frontier"
  },
  "plugins": [
    "research-citations",
    "latex-paper",
    "research-frontier"
  ],
  "api_toolsets": [
    "skills",
    "research_citations",
    "research_papers",
    "cfd_npy3d",
    "ars_resolvers",
    "latex_paper",
    "research_frontier"
  ],
  "mcp_servers": {
    "cfd_npy3d": {
      "env": {"NPY3D_OUT_ROOT": "{root}/workspace/artifacts/cfd", "NPY3D_SAMPLE_DIR": "{root}/workspace/examples/cfd", "MPLCONFIGDIR": "{root}/state/cache/matplotlib", "QT_QPA_PLATFORM": "offscreen"},
      "command": "{root}/venv/bin/python",
      "args": [
        "{release}/mcp/cfd-npy3d/server.py"
      ],
      "enabled": true,
      "timeout": 60,
      "connect_timeout": 30,
      "supports_parallel_tool_calls": false,
      "tools": {
        "include": [
          "npy3d_inspect",
          "npy3d_render_surface",
          "npy3d_render_animation",
          "pvdata_inspect",
          "pvdata_render_scatter3d",
          "pvdata_render_animation",
          "pvdata_import",
          "npy3d_web_viewer"
        ],
        "resources": false,
        "prompts": false
      }
    },
    "research_papers": {
      "command": "{root}/venv/bin/python",
      "args": [
        "{release}/mcp/paper-search/server.py"
      ],
      "enabled": true,
      "timeout": 60,
      "connect_timeout": 30,
      "supports_parallel_tool_calls": false,
      "tools": {
        "include": [
          "crossref_search",
          "crossref_lookup",
          "europepmc_search",
          "europepmc_fulltext"
        ],
        "resources": false,
        "prompts": false
      }
    },
    "ars_resolvers": {
      "command": "{root}/venv/bin/python",
      "args": [
        "{release}/mcp/ars-resolvers/server.py"
      ],
      "enabled": true,
      "timeout": 60,
      "connect_timeout": 30,
      "supports_parallel_tool_calls": false,
      "tools": {
        "include": [
          "openalex_verify",
          "semantic_scholar_verify",
          "arxiv_verify",
          "chinese_literature_verify"
        ],
        "resources": false,
        "prompts": false
      }
    }
  }
}
