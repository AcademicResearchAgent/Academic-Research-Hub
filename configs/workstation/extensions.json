{
  "schema_version": 1,
  "skills": ["research-literature"],
  "plugins": ["research-citations"],
  "api_toolsets": ["skills", "research_citations", "research_papers", "cfd_npy3d"],
  "mcp_servers": {
    "cfd_npy3d": {
      "command": "{root}/venv/bin/python",
      "args": ["{release}/mcp/cfd-npy3d/server.py"],
      "enabled": true,
      "timeout": 60,
      "connect_timeout": 30,
      "supports_parallel_tool_calls": false,
      "tools": {
        "include": ["npy3d_inspect", "npy3d_render_surface", "npy3d_render_animation",
                    "pvdata_inspect", "pvdata_render_scatter3d", "pvdata_render_animation",
                    "pvdata_import"],
        "resources": false,
        "prompts": false
      }
    },
    "research_papers": {
      "command": "{root}/venv/bin/python",
      "args": ["{release}/mcp/paper-search/server.py"],
      "enabled": true,
      "timeout": 60,
      "connect_timeout": 30,
      "supports_parallel_tool_calls": false,
      "tools": {
        "include": ["crossref_search", "crossref_lookup", "europepmc_search", "europepmc_fulltext"],
        "resources": false,
        "prompts": false
      }
    }
  }
}
